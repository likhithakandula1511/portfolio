# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — it will never be committed or exposed publicly.

# Get a free API key at https://resend.com after signing up.
RESEND_API_KEY=re_your_api_key_here

# The email address where contact form submissions should be delivered.
CONTACT_RECEIVER_EMAIL=your@email.com
